# ============================================================================
# Konfigurasi koneksi JalurKu FE — SEMUA via .env (tidak ada lagi UI pengaturan).
# Salin ke `.env` (dev) atau sesuaikan `.env.production` (build) lalu isi.
# ============================================================================

# Base URL Backend FastAPI JalurKu (jalurku-be). Prefix /api/v1 WAJIB.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mode koneksi (opsional): "live" | "demo".
# - live = panggil backend nyata (tetap auto-fallback per-panggilan bila backend tak terjangkau).
# - demo = 100% kalkulasi deterministik lokal, tidak menyentuh jaringan.
# Kosongkan untuk mengikuti mode build: `npm run dev` → demo, `npm run build` → live.
# VITE_API_MODE=live

# Versi consent default untuk pembuatan sesi tamu (opsional, fallback "v1.0").
# VITE_CONSENT_VERSION=2026-10-13

# Dev-tools (persona demo 1-klik). Default: TAMPIL saat `npm run dev`, HILANG saat `npm run build`.
# Override opsional: "true" memaksa tampil, "false" memaksa sembunyi.
# VITE_SHOW_DEV_TOOLS=false
